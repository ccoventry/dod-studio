"dodstudio_ui/Commands.res"
{
	"CommandList"
	{
		"ControlName"		"RichText"
		"fieldName"		"CommandList"
		"xpos"		"8"
		"ypos"		"6"
		"wide"		"520"
		"tall"		"226"
		"visible"		"1"
		"enabled"		"1"
		"text"		"SPECTATING (HLTV demos)\n  dodstudio_spec_match_pov 0/1\n      Make a spectated first-person view match the player's own recording: gun animations, lost gunshots, the crosshair, prone eye height, the gun lowering.\n  dodstudio_spec_lock 0/1\n      Keep the camera on the player you are watching when he dies.\n  dodstudio_spec_target <player>\n      Put the camera on a player (number or name).\n  dodstudio_hide_spectator_bars 0/1\n      Hide the spectator bars and everything on them.\n  dodstudio_hide_hltv_messages 0/1\n      Hide the HLTV proxy's on-screen messages.\n\nHUD\n  dodstudio_hide_scoreboard 0/1\n      Stop a POV demo's recorded TAB presses showing the scoreboard.\n  dodstudio_hide_crosshair 0/1\n      Hide the crosshair and keep it hidden.\n  dodstudio_hide_hand_signals 0/1\n      Replace players' hand-signal animations.\n  dodstudio_mute_voice_commands 0/1\n      Silence voice commands ('fire in the hole!' and the rest).\n  dodstudio_hide_hudelement <name> 0/1\n      Hide one HUD element; the bare command lists them.\n  dodstudio_hide_sprite <model>...\n      Hide entities by model path.\n  dodstudio_deathmsg (or dodstudio_killfeed)\n      Kill feed: max lines, offset, block players, fake a kill. The bare command shows the options.\n  dodstudio_objectives\n      Move the objective icons and the objective timer.\n  dodstudio_overviewmap\n      Move or resize the overview map.\n\nDEMO PLAYBACK\n  dodstudio_seek_to <time>\n      Jump viewdemo playback to a time, in seconds of the VCR bar's clock.\n  dodstudio_seek_by <seconds>\n      Jump forward (or back, with a minus) by that many seconds.\n  dodstudio_seek_skip_between 0/1\n      A jump skips the events and commands it passes over.\n  dodstudio_reload_demo\n      Play the last demo again.\n  dodstudio_clear_decals\n      Clear every decal (bullet holes, blood, sprays).\n  dodstudio_ex_interp_max <ms>\n      Raise the engine's 100 ms ceiling on ex_interp.\n\nDOD STUDIO WINDOW\n  dodstudio_panel [1|0|reset]\n      Open (1) or close (0) this window; bare toggles it; reset restores the default layouts.\n  dodstudio_viewdemo_in_panel 0/1\n      viewdemo opens this window on Playback instead of the VCR bar.\n  dodstudio_console_in_panel 0/1\n      The console key opens this window on the Console tab.\n  dodstudio_resizable_windows 0/1\n      Every game window can be resized by its edges.\n  dodstudio_remember_window_layout 0/1\n      Game windows come back where you left them.\n\nHD TEXTURES\n  dodstudio_hd_enabled 0/1\n      Load the HD textures built by DoD Studio's HD page.\n  dodstudio_hd_style <name>\n      Which HD style to use (ultrasharp by default).\n  dodstudio_allow_shaders 0/1\n      25th Anniversary only: allow the engine's map-surface shaders during playback.\n\nDEBUG\n  dodstudio_debug_status\n      Print everything DoD Studio's hook is doing to the console.\n  dodstudio_debug_msglog <name>...\n      Log chosen game messages to the hook log.\n  dodstudio_debug_hd_misses\n      List the textures that had no HD version, per map.\n  dodstudio_debug_log_weapon_model 0/1\n      Log the weapon model the spectated player holds.\n  dodstudio_debug_log_spectator_target 0/1\n      Log who the spectator camera follows.\n  dodstudio_debug_log_texture_loads 0/1\n      Log every HD texture load.\n"
		"tooltiptext"		"Every DoD Studio console setting and command. Type them in the Console tab."
	}
}
